{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MYOS_DIR": "__MYOS_HOME__/MYOS",
    "MYOS_CONFIG_DIR": "__MYOS_HOME__/MYOS",
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "API_TIMEOUT_MS": "1800000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "20",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3"
  },
  "model": "fable[1m]",
  "autoMemoryEnabled": false,
  "postCompactRestore": {
    "fullFiles": [
      "MYOS/USER/PROJECTS.md"
    ]
  },
  "theme": "dark-daltonized",
  "tui": "fullscreen",
  "teammateMode": "auto",
  "includeGitInstructions": false,
  "fileCheckpointingEnabled": true,
  "worktree": {
    "baseRef": "head"
  },
  "skillListingBudgetFraction": 0.15,
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "bun '__MYOS_HOME__/MYOS/statusline.ts'"
  },
  "_permissionsDocs": "Rules are validated against MergeSettings.KNOWN_TOOL_NAMES at install: a rule naming an unknown tool (MultiEdit, for example) is silently PRUNED, so add the tool name there first. MCP rules are checked by prefix only. autoMode carries the natural language guidance for compound and heredoc shapes that prefix rules cannot express. Do NOT add `Write(<path>)` rules: the harness ignores them for file permission checks and warns on every boot; `Edit(<path>)` covers every file editing tool including Write.",
