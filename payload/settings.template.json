      "mcp__claude_ai_Google_Calendar__update_*",
      "mcp__claude_ai_Google_Calendar__delete_*",
      "mcp__claude_ai_Google_Calendar__move_event",
      "mcp__claude_ai_Google_Calendar__respond_to_event",
