      "Bash(docker:*)",
      "Bash(~/bin/publish:*)",
      "Read(~/.myos/.env)",
      "Read(~/.myos/.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/*)",
      "Bash(rm -rf .git)",
      "Bash(rm -rf ~/.myos*)",
      "Bash(rm -rf ~/.claude*)",
      "Bash(sudo rm -rf:*)",
      "Bash(dd if=* of=/dev/*)",
      "Bash(mkfs*)",
      "Bash(* > /dev/sd*)",
      "Bash(* > /dev/disk*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(curl * | zsh)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | zsh)",
      "Bash(git push --force * main)",
      "Bash(git push --force * master)",
      "Bash(git push -f * main)",
      "Bash(git push -f * master)",
      "Bash(gh repo delete:*)",
      "Bash(chmod -R 777 /)",
      "Bash(chmod -R 777 ~)",
      "Bash(chmod -R 777 $HOME)",
      "Bash(security dump-keychain:*)",
      "Edit(/etc/**)",
      "Edit(/System/**)",
      "Edit(/usr/**)",
      "Edit(/bin/**)",
      "Edit(/sbin/**)",
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*_rsa)",
      "Read(~/.ssh/*_ed25519)",
      "Read(~/.aws/credentials)",
      "Read(~/.gnupg/private*)"
    ]
  },
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "Reading, writing and editing files under ~/.myos/ is safe: it is Harry's own myos harness.",
      "Reading, writing and editing files under ~/Code/ is safe: it holds Harry's projects (comedy business automation, tools for friends and family).",
      "Reading, writing and editing files under ~/Documents/ is safe; ~/Documents/Comedy holds Harry's show material and promotion work.",
      "Compound commands chaining trusted tools are safe: `cd X && bun Y`, `cd X && git log`, `cmd | rg Z` are as safe as their parts.",
      "Piping output through grep, rg, jq, sed, awk, sort, uniq, head, tail, wc is safe: these are read-only filters.",
      "Running bun, bunx, git read and commit subcommands (status, log, diff, show, add, commit), gh, and curl to READ a URL is routine work.",
      "Writing to MYOS/MEMORY/, MYOS/USER/ and the session scratchpad is routine bookkeeping.",
      "Editing ~/.myos/settings.json, ~/.myos/CLAUDE.md, ~/.myos/hooks/** and ~/.myos/skills/** at Harry's request is maintenance; the conversation instruction is the authorization.",
      "Spawning subagents for research, exploration and review is standard workflow."
    ],
    "hard_deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/.myos*)",
      "Bash(rm -rf ~/.claude*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -fr*)",
      "Bash(rm -r -f*)",
      "Bash(sudo rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(curl* | sh*)",
      "Bash(curl* | bash*)",
      "Bash(wget* | sh*)",
      "Bash(wget* | bash*)",
      "Bash(dd if=*of=/dev/*)",
      "Bash(mkfs*)",
      "Bash(gh repo delete*)",
      "Bash(rsync --delete *prod*)",
      "Bash(security dump-keychain*)"
    ],
    "environment": [
      "~/.myos/ is Harry's myos harness (hooks, skills, MEMORY). Operations inside it are trusted.",
      "~/Code/ holds Harry's projects: comedy business automation (the IN YOUR FACE site, Meta ads scripts, Eventfrog sales tracking, Grist tables) and small tools for friends and family. Building, testing, grepping and committing there is routine.",
      "~/Documents/Comedy holds show material, promotion videos and flyers; editing and rendering there is routine.",
      "Compound shell commands and heredocs into git commit -F - are normal: approve when each part is trusted.",
      "These change live state and ALWAYS warrant a prompt: deploys, `~/bin/publish`, git push and any force push, launchctl, crontab, writes to Grist (curl POST, PUT, PATCH or DELETE to getgrist.com), and Meta ads or other scripts run with `--apply` or `--activate`.",
      "Reading Google Calendar, Drive and Gmail through the claude.ai connectors is routine and auto-approved. Creating, changing, sending or deleting anything there is outward facing and always warrants a prompt.",
      "Credential access, package installs (npm, pip, brew) and anything touching production are not routine."
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/HookHealer.hook.ts'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/LoadContext.hook.ts'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/TrialClock.hook.ts'",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/TimeContext.hook.ts'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/DriftReminder.hook.ts'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/PromptProcessing.hook.ts'",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/ModelRungGuard.hook.ts'",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "'__MYOS_HOME__/hooks/ContextReduction.hook.sh'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/PublicPushGate.hook.ts'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/ISAStaleWriteGuard.hook.ts'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/AgentInvocation.hook.ts'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/AgentInvocation.hook.ts'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/ISASync.hook.ts'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/CheckpointPerISC.hook.ts'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/ISAStaleWriteGuard.hook.ts'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/Safety.hook.ts'",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/LoopDetector.hook.ts'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/EventLogger.hook.ts'",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/EventLogger.hook.ts'",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/LoopDetector.hook.ts'",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/Safety.hook.ts'",
            "timeout": 5
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/TaskGovernance.hook.ts'",
            "timeout": 5
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/EventLogger.hook.ts'",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/LastResponseCache.hook.ts'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/StopGates.hook.ts'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/SessionCleanup.hook.ts'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bun '__MYOS_HOME__/hooks/TokenLog.hook.ts'",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}
