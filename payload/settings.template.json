      "mcp__claude_ai_Gmail__update_*",
      "mcp__claude_ai_Gmail__delete_*",
      "mcp__claude_ai_Gmail__modify_*",
      "Bash(git push:*)",
      "Bash(git rm:*)",
      "Bash(git reset:*)",
